# Settings

class Settings:
    """config.json: read once; docklet only ever rewrites its "pinned"."""

    def __init__(self):
        self.raw, self.broken = {}, False
        try:
            with open(CONFIG_FILE, encoding="utf-8") as f:
                self.raw = json.load(f)
            if not isinstance(self.raw, dict):
                raise ValueError("it is not an object")
        except FileNotFoundError:
            pass
        except (OSError, ValueError) as e:
            # left alone: pins are not saved over a file that does not parse
            warn("%s: %s" % (CONFIG_FILE, e))
            self.raw, self.broken = {}, True

    def get(self, key):
        default = DEFAULTS[key]
        value = self.raw.get(key, default)
        if isinstance(default, bool):
            ok = isinstance(value, bool)
        elif isinstance(default, int):
            ok = isinstance(value, (int, float)) and not isinstance(value, bool) and value >= 0
            value = int(value) if ok else value
        elif isinstance(default, list):
            ok = isinstance(value, list) and all(isinstance(v, str) for v in value)
        else:
            ok = isinstance(value, str)
        if key == "position" and value not in EDGES:
            ok = False
        if not ok:
            warn('config.json: "%s": %r is not valid, using %r' % (key, value, default))
            return default
        return value

    def save_pinned(self, pinned):
        if self.broken:
            warn("config.json does not parse: the pinned applications are not saved")
            return
        self.raw["pinned"] = list(pinned)
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            tmp = CONFIG_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.raw, f, indent=2, ensure_ascii=False)
                f.write("\n")
            os.replace(tmp, CONFIG_FILE)
        except OSError as e:
            warn("%s: %s" % (CONFIG_FILE, e))


# ---------------------------------------------------------------------------
# rivermonad

def socket_path():
    path = os.path.join(RUNTIME, "rivermonad-%s.sock" % os.environ.get("WAYLAND_DISPLAY", "wayland-0").replace("/", "_"))
    if not os.path.exists(path):
        path = os.environ.get("RIVERMONAD_SOCKET", "") or path
    return path


def action(a):
    """Send an action to rivermonad, in the background."""
    def send():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(2)
                s.connect(socket_path())
                s.sendall((json.dumps({"Action": a}) + "\n").encode())
                s.recv(4096)
        except OSError as e:
            warn("rivermonad: %s" % e)
    threading.Thread(target=send, daemon=True).start()


def follow(on_state):
    """Follow rivermonad's "EventStream" for ever, from a thread: on_state
    gets every new state in the main loop, and None once rivermonad has
    been gone for a few seconds (a restart takes about one)."""
    failures = 0
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(socket_path())
                s.sendall(b'"EventStream"\n')
                failures = 0
                buf = b""
                while True:
                    chunk = s.recv(1 << 16)
                    if not chunk:
                        break
                    *lines, buf = (buf + chunk).split(b"\n")
                    state = None
                    for line in lines:
                        try:
                            msg = json.loads(line)
                        except ValueError:
                            continue
                        if isinstance(msg, dict) and isinstance(msg.get("State"), dict):
                            state = msg["State"]
                    if state is not None:   # only the newest of a burst
                        GLib.idle_add(on_state, state)
        except OSError:
            pass
        failures += 1
        if failures == 10:
            GLib.idle_add(on_state, None)
        time.sleep(0.3)


